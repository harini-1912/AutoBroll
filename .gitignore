# Byte-compiled / optimized / Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Local Environment & Secrets
.env
.env.*
!.env.example
*.local
*.pem
*.key

# Application Artifacts, Temporary Data & Caches
/artifacts/
/temp/
/tmp/
/data/
/storage/
*.db
*.sqlite
*.sqlite3
*.log

# Explicitly ensure app packages are never ignored
!app/
!app/**/
!app/storage/
!app/storage/*.py
!backend/app/storage/
!backend/app/storage/*.py
!app/**/__init__.py
!backend/app/**/__init__.py

# Re-enforce ignore of byte-compiled files everywhere
__pycache__/
*.py[cod]

# Media & Rendered Assets
*.mp4
*.wav
*.mp3
*.m4a
*.mov
*.webm
*.part
*.tmp*
*.jpg
*.jpeg
*.png
*.webp
!static/
!frontend/
!test_pack/fixtures/*.mp3
!test_pack/fixtures/*.wav

# OS specific
.DS_Store
Thumbs.db
