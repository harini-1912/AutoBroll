# Environment & Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
APP_NAME="IncuBrix B-Roll Video Engine"
APP_VERSION="1.0.0"

# Security & Limits
DEMO_API_KEY=""
MAX_UPLOAD_SIZE_MB=50
MAX_AUDIO_DURATION_SECONDS=600
RATE_LIMIT_PER_MINUTE=60
WEBHOOK_SIGNATURE_SECRET="incubrix_secret_key_change_in_production"

# Storage Configuration
STORAGE_BACKEND=local
# Options: 'local' or 's3'
LOCAL_STORAGE_DIR="./storage"
BASE_URL="http://localhost:8000"

# S3 / MinIO Configuration (Optional for cloud/container deployment)
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="incubrix-videos"
S3_REGION="us-east-1"
S3_USE_SSL=false

# Database Configuration
DATABASE_URL="sqlite:///./data/incubrix.db"

# FFmpeg Configuration
FFMPEG_PATH=""
FFPROBE_PATH=""

# Footage Providers
FOOTAGE_PRIMARY_PROVIDER=mock
# Options: 'pexels', 'pixabay', 'ai_motion', 'curated', 'mock'
PEXELS_API_KEY=""
PIXABAY_API_KEY=""
REPLICATE_API_TOKEN=""

# TTS Configuration
TTS_PROVIDER=gtts
# Options: 'gtts', 'edge_tts', 'mock'
DEFAULT_VOICE="en-IN-female"

# Concurrency & Worker
MAX_CONCURRENT_JOBS=2
JOB_RETENTION_HOURS=24
